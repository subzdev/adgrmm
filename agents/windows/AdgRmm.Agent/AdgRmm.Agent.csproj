<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>

    <!-- Opt this project out of repo-wide Central Package Version Management -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>


    <Nullable>enable</Nullable>
    <!-- The same source gives the same bytes on any machine, so a build can be checked against another. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Publish -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained, so a clean PC does not need .NET installed. -->
    <SelfContained>true</SelfContained>
    <Version>1.3.62</Version>

    <!-- Keep it simple + stable for now (no linker) -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- IMPORTANT for native codec DLLs (VP8/H264/etc) when PublishSingleFile=true -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <AssemblyName>AdgRmm.Agent</AssemblyName>
    <RootNamespace>AdgRmm.Agent</RootNamespace>
    <OutputType>Exe</OutputType>

    <!-- The tray app (a small icon and a few windows for the person using the computer) runs from this same executable. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Windows Forms adds global usings for System.Windows.Forms and System.Drawing; the rest of the agent was written without them
       (Timer, Size and Point would be ambiguous), so only the tray files name them. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!--
    The VP8 encoder (vpxmd.dll) needs the Visual C++ runtime, which a new Windows install may not have.
    Without it the encoder cannot load, and Remote Console connects but shows a black screen.
    A release build fails here rather than shipping without it.
  -->
  <ItemGroup Condition="Exists('$(SystemRoot)\System32\vcruntime140.dll')">
    <Content Include="$(SystemRoot)\System32\vcruntime140.dll" Link="vcruntime140.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireVcRuntime" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' And !Exists('$(SystemRoot)\System32\vcruntime140.dll')">
    <Error Text="vcruntime140.dll was not found on the build machine. The video encoder cannot run without it." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />

    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="3.1.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="11.0.0" />

    <!-- NOTE: keep for now to avoid breaking other code paths while transitioning -->
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="10.0.17" />
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="10.0.4" />

    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\shared\*.cs" LinkBase="Shared" />
    <EmbeddedResource Include="scripts\apply-update.ps1" LogicalName="AdgRmm.Agent.apply-update.ps1" />
    <EmbeddedResource Include="Tray\tray-logo.png" LogicalName="AdgRmm.Agent.tray-logo.png" />
  </ItemGroup>

  <!-- Build dependency only; we publish it manually below -->
  <PropertyGroup>
    <!-- The remote console is optional: it needs a native DLL built separately against libwebrtc. -->
    <NativeWebRtcDll>$(MSBuildProjectDirectory)\..\..\..\native\RemoteIQ.NativeWebRtc\bin\x64\Release\RemoteIQ.NativeWebRtc.dll</NativeWebRtcDll>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(NativeWebRtcDll)')">
    <ProjectReference Include="..\AdgRmm.CaptureHelper\AdgRmm.CaptureHelper.csproj" />
  </ItemGroup>

  <!-- Native WebRTC DLL: copy for local run AND force it to appear in publish output next to the EXE -->
  <ItemGroup Condition="Exists('$(NativeWebRtcDll)')">
    <Content Include="$(NativeWebRtcDll)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>

      <!-- CRITICAL: prevents it from being bundled into AdgRmm.Agent.exe -->
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>

      <Link>RemoteIQ.NativeWebRtc.dll</Link>
    </Content>
  </ItemGroup>

  <!-- Publish CaptureHelper and stage it into Agent publish output -->
  <Target Name="PublishCaptureHelperIntoAgentPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_CaptureHelperProject>$(MSBuildProjectDirectory)\..\AdgRmm.CaptureHelper\AdgRmm.CaptureHelper.csproj</_CaptureHelperProject>
      <_CaptureHelperStagingDir>$(MSBuildProjectDirectory)\obj\capture_helper_publish\</_CaptureHelperStagingDir>

      <_CaptureHelperDestDir>$(PublishDir)tools\capture-helper\</_CaptureHelperDestDir>
      <_CaptureHelperExeStaged>$(_CaptureHelperStagingDir)AdgRmm.CaptureHelper.exe</_CaptureHelperExeStaged>
      <_CaptureHelperExeDest>$(_CaptureHelperDestDir)AdgRmm.CaptureHelper.exe</_CaptureHelperExeDest>
    </PropertyGroup>

    <Message Importance="high" Text="ADG RMM: publishing CaptureHelper to '$(_CaptureHelperStagingDir)'." />
    <MakeDir Directories="$(_CaptureHelperStagingDir)" />

    <!-- Publish CaptureHelper as single-file exe into a flat staging dir.
         It starts for every session, so it is neither compressed nor unpacked to a temp folder:
         both are paid at each launch, and antivirus also scans whatever gets unpacked. -->
    <Exec
      Command='dotnet publish &quot;$(_CaptureHelperProject)&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained true /p:SelfContained=true /p:PublishSingleFile=true /p:UseAppHost=true /p:PublishTrimmed=false /p:EnableCompressionInSingleFile=false /p:IncludeNativeLibrariesForSelfExtract=false /p:IncludeAllContentForSelfExtract=false /p:PublishDir=&quot;$(_CaptureHelperStagingDir)&quot;'
    />

    <MakeDir Directories="$(_CaptureHelperDestDir)" />

    <!-- Hard fail if EXE isn't produced -->
    <Error
      Condition="!Exists('$(_CaptureHelperExeStaged)')"
      Text="ADG RMM: CaptureHelper publish did not produce AdgRmm.CaptureHelper.exe at '$(_CaptureHelperStagingDir)'."
    />

    <Copy
      SourceFiles="$(_CaptureHelperExeStaged)"
      DestinationFiles="$(_CaptureHelperExeDest)"
      SkipUnchangedFiles="true"
    />

    <Message Importance="high" Text="ADG RMM: staged CaptureHelper EXE -> '$(_CaptureHelperExeDest)'." />
  </Target>

</Project>
